generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum OrderSource {
  WEBSITE
  MANUAL
  FACEBOOK
  PHONE
  WHATSAPP
  OTHER
  UNKNOWN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_TO_SHIP // labeled "RTS" in the admin UI
  SHIPPED
  PARTIAL // shipped, only some items delivered/confirmed so far
  DELIVERED
  PENDING_RETURN // customer/courier has started a return, goods not back yet
  RETURNED
  PENDING_CANCEL // cancellation requested, not yet finalized — stock stays reserved
  CANCELLED
  PREORDER // booked ahead of stock arriving; otherwise behaves like PENDING
  LOST // shipped, then lost in transit — stock was already deducted at ship time
}

// Tracks whether a customer has actually been reached and how they
// responded — independent of Order.status (a PENDING order can be
// CONFIRMED here after a phone call, before its status ever changes).
// See ARCHITECTURE.md §17.
enum CustomerResponseStatus {
  NO_RESPONSE
  GOOD_BUT_NO_RESPONSE
  ON_HOLD
  ADVANCE_PAYMENT
  CALL_BACK
  INTERESTED
  NOT_INTERESTED
  CONFIRMED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum ShipmentStatus {
  NOT_SHIPPED
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

// The set of courier APIs this install knows how to talk to — see
// src/integrations/providers/provider-registry.ts for the adapter behind
// each value. Adding a new courier means adding a value here plus an
// adapter class; no other schema change needed.
enum IntegrationProvider {
  STEADFAST
}

// StockMovement.type: direction is encoded by the sign of `quantity`,
// this enum only records *why* the movement happened (see ARCHITECTURE.md
// "Inventory Strategy" for the full state machine).
enum StockMovementType {
  PURCHASE // + stock received from a supplier
  RESERVE // - moves stock from available -> reserved (order placed)
  RELEASE // + moves stock from reserved -> available (order cancelled pre-fulfillment)
  DEDUCT // - reserved stock leaves the building (order shipped)
  RETURN // + stock physically comes back (order returned post-fulfillment)
  ADJUSTMENT // +/- manual stock count correction
  DAMAGE // - written off, lost or damaged stock
}

enum StockReferenceType {
  ORDER
  PURCHASE
  MANUAL_ADJUSTMENT
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

// =====================================================================
// RBAC
// =====================================================================

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  roleId       String
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Profile fields — optional, purely informational (not used by any
  // auth/permission logic), shown on the New/Edit User form.
  avatarUrl    String?
  phone        String?
  employeeCode String?
  gender       String?
  joiningDate  DateTime?
  shift        String?
  designation  String?
  about        String?

  role Role @relation(fields: [roleId], references: [id])

  createdOrders       Order[]                 @relation("OrderCreatedBy")
  orderStatusChanges  OrderStatusHistory[]
  stockMovements      StockMovement[]
  auditLogs           AuditLog[]
  purchases           Purchase[]
  channels            UserChannel[]
  permissions         UserPermission[]
  channelPermissions  UserChannelPermission[]
  createdIntegrations Integration[]           @relation("IntegrationCreatedBy")
  updatedIntegrations Integration[]           @relation("IntegrationUpdatedBy")
  orderLocks          OrderLock[]

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id           String                  @id @default(cuid())
  key          String                  @unique // e.g. "orders.create", "products.publish"
  label        String
  roles        RolePermission[]
  users        UserPermission[]
  userChannels UserChannelPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Per-user permission grants for every role except Super Admin (which is
// always every permission, enforced in code — see AuthService). Admin,
// Manager and Member all get their own individually toggled set here
// instead of sharing one fixed role-wide list, so two users with the same
// role can have different access. This table specifically holds the
// "All Stores" scope's grants — what the user can do when no specific
// store is active. UserChannelPermission below holds the per-store
// counterpart; the two are deliberately separate sets, not one list
// filtered by scope, so a permission can be on for "All Stores" and off
// for a specific store (or vice versa) at the same time.
model UserPermission {
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// A user's permission grants scoped to one specific store — independent of
// their "All Stores" grants (UserPermission) and of any other store's.
model UserChannelPermission {
  userId       String
  channelId    String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, channelId, permissionId])
  @@map("user_channel_permissions")
}

// =====================================================================
// CHANNELS (storefronts)
// =====================================================================

model Channel {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique // used in /store/:slug and NEXT_PUBLIC_CHANNEL
  domain      String?   @unique
  logoUrl     String?
  themeConfig Json? // per-storefront theme tokens, optional
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  productChannels ProductChannel[]
  orders          Order[]
  users           UserChannel[]
  userPermissions UserChannelPermission[]
  checkoutLeads   CheckoutLead[]
  integrations    Integration[]

  @@map("channels")
}

// A storefront checkout that is not complete yet: the customer has entered a
// valid mobile number (and usually products) but not the name/address needed
// to place the order. Shown as Incomplete on Web Orders. One row per
// channel + phone; it is deleted when an order is placed with that phone.
model CheckoutLead {
  id               String                  @id @default(cuid())
  channelId        String
  phone            String
  name             String?
  address          String?
  items            Json // [{ productId, quantity, unitPrice }] as the customer entered them
  // Items as the admin is preparing them in Ordered products; empty until edited.
  adminItems       Json?
  // Empty until set from Order actions; an empty response keeps the lead in Incomplete.
  // Carried to the order when it is created.
  customerResponse CustomerResponseStatus?
  // Set when cancelled from Order actions; puts the lead in the Cancel tab.
  cancelledAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  channel Channel @relation(fields: [channelId], references: [id])

  @@unique([channelId, phone])
  @@map("checkout_leads")
}

// Which channels a user's access applies to — orthogonal to Role (which
// governs *what* they can do). A user holding the `channels.all_access`
// permission ignores this table entirely (unrestricted); everyone else is
// restricted to exactly these channels, and zero rows means zero access
// (fails closed, not open). See ARCHITECTURE.md §14.
model UserChannel {
  userId    String
  channelId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@map("user_channels")
}

// =====================================================================
// CATALOG
// =====================================================================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  imageUrl    String?
  parentId    String?
  isPublished Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  // Additional storefront categories a product can be tagged with, on top
  // of its one primary `categoryId` above — see ProductCategory.
  productCategories ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  logoUrl   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  products Product[]

  @@map("brands")
}

// The master product. Holds truth that is NOT storefront-specific:
// SKU, cost, base price, stock link. Anything a storefront may override
// lives on ProductChannel instead.
model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String?
  costPrice   Decimal   @db.Decimal(12, 2)
  basePrice   Decimal   @db.Decimal(12, 2) // fallback price if a channel doesn't override
  unit        String    @default("pcs")
  categoryId  String?
  brandId     String?
  // The single image shown anywhere a product needs a small icon (order
  // lines, inventory, product lists) — distinct from `images` below, which
  // is the storefront's full photo gallery. Falls back to the gallery's
  // first image wherever it's read, so existing products don't go blank
  // until an admin explicitly sets one.
  thumbnailUrl String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])
  brand    Brand?    @relation(fields: [brandId], references: [id])

  images         ProductImage[]
  channels       ProductChannel[]
  inventory      Inventory?
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  // Additional storefront categories, on top of the single `category`
  // above — lets a product show up on more than one category page.
  categories     ProductCategory[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

// Extra (product, category) tags beyond Product.categoryId — a product can
// appear on several storefront category pages at once. Additive: the
// original single categoryId/category relation above is untouched and still
// drives the admin's existing single-select Category field.
model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// One row per (product, channel) the product is published to.
// Absence of a row = not published on that channel.
model ProductChannel {
  id             String   @id @default(cuid())
  productId      String
  channelId      String
  name           String? // overrides Product.name on this channel
  slug           String // unique per channel, used in /store/:slug/products/:slug
  description    String?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  isPublished    Boolean  @default(false)
  isFeatured     Boolean  @default(false)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([productId, channelId])
  @@unique([channelId, slug])
  @@index([channelId, isPublished])
  @@map("product_channels")
}

// =====================================================================
// INVENTORY
// =====================================================================

// availableStock is NOT stored — it is always (currentStock - reservedStock),
// computed at read time or returned via a view/select. Storing it would let
// it drift out of sync with the two source columns.
model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  currentStock      Int      @default(0)
  reservedStock     Int      @default(0)
  lowStockThreshold Int      @default(10)
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// Append-only ledger. Every change to Inventory MUST be paired with a row
// here in the same transaction — this is the audit trail that answers
// "why is stock what it is".
model StockMovement {
  id            String              @id @default(cuid())
  productId     String
  type          StockMovementType
  quantity      Int // signed delta applied to currentStock or reservedStock
  balanceAfter  Int // currentStock snapshot after this movement
  referenceType StockReferenceType?
  referenceId   String? // e.g. Order.id or Purchase.id
  note          String?
  createdById   String?
  createdAt     DateTime            @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

// =====================================================================
// CUSTOMERS
// =====================================================================

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  email     String?
  address   String?
  city      String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders Order[]

  @@map("customers")
}

// =====================================================================
// ORDERS
// =====================================================================

model Order {
  id               String                  @id @default(cuid())
  orderNumber      String                  @unique // human-readable, e.g. OBM-10001
  channelId        String? // null allowed for e.g. a pure phone/manual order with no storefront
  source           OrderSource
  customerId       String
  status           OrderStatus             @default(PENDING)
  paymentStatus    PaymentStatus           @default(UNPAID)
  shipmentStatus   ShipmentStatus          @default(NOT_SHIPPED)
  // Empty until someone sets it from Web Orders; an empty response means the
  // order is waiting in Processing.
  customerResponse CustomerResponseStatus?

  subtotal    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  shippingFee Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  // Shipping details are snapshotted onto the order (not FK'd to a live
  // Customer address) so editing a customer later never rewrites history.
  shippingName    String
  shippingPhone   String
  shippingAddress String
  notes           String?
  // Informational only, set at order-creation time (before a Shipment even
  // exists) — e.g. "Steadfast", "Pathao". Distinct from Shipment.courierName,
  // which is set later, when the order actually ships.
  deliveryMethod  String?

  createdById   String? // staff user for MANUAL/PHONE/etc orders; null for WEBSITE
  // Set when a website order is approved from Web Orders; until then it is
  // kept out of the Order List.
  webApprovedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  channel   Channel? @relation(fields: [channelId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User?    @relation("OrderCreatedBy", fields: [createdById], references: [id])

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  shipment      Shipment?

  @@index([channelId])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@map("orders")
}

// Prices/names are snapshotted at order time. Master Product/ProductChannel
// data can change later without ever altering a historical order total.
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

// Who currently has a Web Order detail page open — Web Orders list &
// takeover/"Access Restricted" feature. orderId is the same id the Web
// Orders list already uses per row (a real Order.id, or the synthetic
// "lead-<CheckoutLead.id>" used for incomplete checkouts) — not an FK to
// Order, since a lead has no Order row yet. A row with no fresh heartbeat
// (see LOCK_TTL_MS in order-locks.service.ts) is treated as expired and
// swept on the next read, so a crashed/closed tab never locks an order
// forever.
model OrderLock {
  id        String   @id @default(cuid())
  orderId   String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("order_locks")
}

// =====================================================================
// PAYMENTS
// =====================================================================

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(UNPAID)
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

// =====================================================================
// COURIER INTEGRATIONS
// =====================================================================

// One configured courier account. `credentials` is always an encrypted
// blob (see EncryptionService) — never plaintext, never returned to the
// frontend. `label` lets the same provider be configured more than once
// (two Steadfast accounts, say). Display status (Connected/Disconnected/
// Error/Disabled) is derived from isEnabled + lastTestSuccess in the
// service layer rather than stored, so it can't drift from reality.
model Integration {
  id              String              @id @default(cuid())
  provider        IntegrationProvider
  label           String
  channelId       String? // null = account-wide, not tied to one storefront
  credentials     Json // encrypted compound blob, see EncryptionService
  // Encrypted, same scheme as credentials. Generated on demand and shown
  // to the admin exactly once (to paste into the provider's webhook
  // settings) — never re-displayed after that, only regenerated.
  webhookSecret   String?
  isEnabled       Boolean             @default(true)
  isDefault       Boolean             @default(false)
  lastTestedAt    DateTime?
  lastTestSuccess Boolean?
  lastTestMessage String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  channel   Channel? @relation(fields: [channelId], references: [id])
  createdBy User?    @relation("IntegrationCreatedBy", fields: [createdById], references: [id])
  updatedBy User?    @relation("IntegrationUpdatedBy", fields: [updatedById], references: [id])

  shipments Shipment[]

  @@index([provider])
  @@map("integrations")
}

model Shipment {
  id                    String               @id @default(cuid())
  orderId               String               @unique
  courierName           String?
  trackingNumber        String?
  status                ShipmentStatus       @default(NOT_SHIPPED)
  shippedAt             DateTime?
  deliveredAt           DateTime?
  // Set only when booked through a configured Integration — a shipment
  // can still exist with just courierName/trackingNumber typed manually,
  // same as before this module existed.
  provider              IntegrationProvider?
  integrationId         String?
  externalConsignmentId String?
  externalTrackingCode  String?
  codAmount             Decimal?             @db.Decimal(12, 2)
  rawResponse           Json?
  lastSyncedAt          DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  integration Integration?    @relation(fields: [integrationId], references: [id])
  events      ShipmentEvent[]

  @@map("shipments")
}

// Append-only history for a shipment's lifecycle — mirrors
// OrderStatusHistory's pattern. Populated from webhook/poll updates, not
// yet wired up in this phase (createShipment's response is the first row).
model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  note        String?
  rawResponse Json?
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_events")
}

// =====================================================================
// SUPPLIERS / PURCHASES
// =====================================================================

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id          String         @id @default(cuid())
  supplierId  String
  status      PurchaseStatus @default(DRAFT)
  totalCost   Decimal        @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime       @default(now())
  receivedAt  DateTime?

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User?          @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@map("purchase_items")
}

// =====================================================================
// SETTINGS
// =====================================================================

// Single-row-per-key store for small global config (business profile,
// default low-stock threshold). `value` is JSON so adding a setting never
// needs a migration.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// =====================================================================
// AUDIT
// =====================================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // e.g. "product.update", "order.status_change"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}
