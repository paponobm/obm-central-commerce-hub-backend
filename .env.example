DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

PORT=3000
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
CORS_ORIGINS="http://localhost:3001"
PUBLIC_URL="http://localhost:3000"

# AES-256 key (32 bytes, base64) used to encrypt courier integration
# credentials at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY="change-me"

# STORAGE_DRIVER picks where /admin/uploads/image saves files: "local"
# (default, writes to ./uploads) or "cloudinary" (no persistent disk
# needed — for a free-tier test deploy). Switch by changing this one
# value per environment, not by commenting code before a push.
STORAGE_DRIVER="local"
# CLOUDINARY_CLOUD_NAME="change-me"
# CLOUDINARY_API_KEY="change-me"
# CLOUDINARY_API_SECRET="change-me"
# CLOUDINARY_FOLDER="change-me"
